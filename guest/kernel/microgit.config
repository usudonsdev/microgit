# 最小ゲストのカーネル設定（Issue #15、AD-7）。allnoconfig に重ねる。
# ここに書いた =y はビルド後にすべて有効になっているか build.sh が確かめる。
# 方針: virtio だけ、ネットワークなし（CONFIG_NET も無効）、OverlayFS あり、モジュールなし。

# サイズ優先
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# 起動と初期 RAM ディスク（agent を /init として埋め込む）
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_BINFMT_ELF=y
CONFIG_PRINTK=y
CONFIG_TTY=y

# Go のランタイムが使うシステムコール（allnoconfig では切られている）
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_TIMERFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_MULTIUSER=y

# ファイルシステム
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
# upper を tmpfs に置き、userxattr で使うため（tmpfs の user.* xattr は 6.6 以降）
CONFIG_TMPFS_XATTR=y
CONFIG_OVERLAY_FS=y

# デバイス: PCI 上の virtio。PCI ホストの見つけ方は CPU の種類ごとの設定（microgit-<ARCH>.config）で足す
CONFIG_PCI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
# hvc0（カーネルのログ）と、名前付きポート "microgit"（agent との通り道）
CONFIG_VIRTIO_CONSOLE=y
