# 同梱する Linux カーネル（Issue #15）。長期サポート版を固定する。
# 上げるときは kernel.org の sha256sums.asc から値を写し、ゴールデンテストを流し直す。
KERNEL_VERSION=6.18.53
KERNEL_SHA256=4d6fba95c2244b08a7b4144a4d38b9be4fb31abb5e7682ae40bb5cb11374cfe0

# agent をビルドする Go（#15、再現可能なビルドのため固定。NFR-6）。
# guest/agent/go.mod の go 1.24 は「言語の最低版」で、ビルドに使う版とは別。
# CI（guest.yml）はこの値で setup-go する。上げるときはサポート中の版（go.dev/dl）から選ぶ。
GO_VERSION=1.27.1
