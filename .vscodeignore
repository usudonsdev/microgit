.vscode/**
.vscode-test/**
src/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*

.microgit_logs/**
.microgit_shadow/**
.microgit_overlay/**
photo/**
.cursor/**
*.vsix
test_dummy.py
assets/**

.github/**
articles/**
# Zenn の記事の図（リポジトリの直下の images/ は Zenn の決まり）。配らない（#57 で足したのが VSIX に入った）
images/**
markdowns/**
docs/**
books/**
**/*.vsix
out/test/**
src/test/**
test/**
guest/**
mac/**
windows/**
# 開発用のスクリプト（ベンチ・スモーク・テスト・VSIX 作り）は配らない（#19）
scripts/**
# README は 2 つある。GitHub に出る詳しい README.md は配らず、ストア向けの README-marketplace.md を
# vsce package --readme-path で VSIX の readme.md にする（両方入れると大文字小文字だけ違う同じ名前になり、vsce が止まる）
README.md
README-marketplace.md
# エージェント向けの作業メモは配らない
AGENTS.md
CLAUDE.md
package-lock.json
dist/**
.cache/**
# CI で成果物を落とす場所（package.yml はリポジトリの外に落とすが、手元で同じ名前を使ったときのため）
artifacts/**
# 同梱の部品（resources/kernel）は scripts/package-vsix.mjs がターゲットごとに置く。ここでは外さない
